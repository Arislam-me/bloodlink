APP_NAME=BloodLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bloodlink
DB_USERNAME=bloodlink
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# local dev: sync (inline). production: database or redis + a `php artisan queue:work` process
QUEUE_CONNECTION=sync

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# local dev: log (emails go to storage/logs/laravel.log). production: smtp / ses / postmark ...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bloodlink.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Comma-separated proxy IPs (or *) when behind a load balancer / Cloudflare.
TRUSTED_PROXIES=

# ---------------------------------------------------------------- BloodLink
# Mobile OTP delivery. "log" writes codes to storage/logs (development only).
# "http" posts to a Bangladeshi SMS gateway; adjust payload in app/Services/Sms/HttpSmsSender.php.
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

BLOODLINK_VIEW_ALERT_THRESHOLD=50
SUPPORT_EMAIL=support@bloodlink.test

# Optional first admin created by `php artisan db:seed` (or use `php artisan bloodlink:create-admin`).
ADMIN_NAME="BloodLink Admin"
ADMIN_EMAIL=
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=

# Synthetic demo donors/requests for local development (ignored in production).
SEED_DEMO_DATA=false

# Google reCAPTCHA v2 checkbox on registration and login forms.
# Get keys at https://www.google.com/recaptcha/admin (reCAPTCHA v2 -> "I'm not a robot").
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
